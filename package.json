{
  "name": "dsh-mods-enhanced",
  "version": "1.0.0",
  "description": "DSH 增强功能静态化常驻包(bundle):余额查询/会话完成提醒/费用预估与账单明细/粘贴图片转文字/Token 用量统计;仓库另含模型选择器增强等插件源码与一键安装脚本",
  "type": "module",
  "main": "./插件类/dsh-mods-enhanced/lib/index.js",
  "exports": {
    ".": "./插件类/dsh-mods-enhanced/lib/index.js",
    "./client": "./插件类/dsh-mods-enhanced/lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin"
  ],
  "files": [
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "插件类",
    "增强主页类",
    "patches",
    "scripts",
    "docs",
    "hooks",
    "其他"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0"
  },
  "license": "MIT"
}
